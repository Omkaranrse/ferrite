# ==========================================
# Ferrite Structural Steels — Environment Configuration
# ==========================================

# 1. Canonical Site URL (Used for sitemaps, canonical meta tags, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://ferrite.in

# 2. Google Analytics 4 (GA4) Measurement ID
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 3. Google Search Console Verification Code
# Example: google1234567890abcdef.html or meta content tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 4. RFQ / Tender Email Forwarding (Optional Resend API Integration)
# When configured, customer submissions to /api/enquiry dispatch direct HTML notifications
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=contact@ferrite.in

# 5. Internal CRM / ERP Webhook Endpoint (Optional)
# Dispatches incoming RFQ payload JSON directly to your sales pipeline or ERP
ENQUIRY_WEBHOOK_URL=
